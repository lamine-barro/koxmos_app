# OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
PORT=4242

# Production : ce broker refuse volontairement de démarrer. Remplacez le registre
# fichier par PostgreSQL transactionnel avant d'autoriser toute facturation réelle.
# KOXMOS_STATE_FILE=/var/lib/koxmos/billing-state.json
# NODE_ENV=production

# Checkout Jèko. Aucun crédit ne doit être ajouté côté client : un futur webhook
# signé du prestataire est la seule source de vérité pour une recharge payée.
JEKO_STORE_ID=
JEKO_API_KEY=
JEKO_API_KEY_ID=
KOXMOS_PUBLIC_URL=https://api.example.com
